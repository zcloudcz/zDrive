# zDrive environment variables
# Copy to .env and fill in real values. Never commit .env.

# Azure Blob Storage (local dev: Azurite connection string)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1

# PostgreSQL
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=zdrive;Username=zdrive;Password=zdrive_dev

# Azure Service Bus (local dev: RabbitMQ)
SERVICE_BUS_CONNECTION_STRING=amqp://guest:guest@localhost:5672

# Azure SignalR (local dev: self-hosted)
SIGNALR_CONNECTION_STRING=

# Azure AI Vision
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_KEY
JWT_ISSUER=zdrive

# JWT RSA public key (PEM), required outside Development — see CLAUDE.md
# "JWT dev keys". Safe to share with every service (only verifies tokens).
# The private key goes in .env.auth-secrets instead (see
# .env.auth-secrets.example) so it's loaded only by auth-service, which is
# the only service that needs to sign tokens.
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# then paste the PEM with real newlines replaced by \n, wrapped in double
# quotes (docker compose unescapes \n inside quoted .env values).
Jwt__RsaPublicKeyPem=

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# Seq (structured logging)
SEQ_URL=http://localhost:5341
