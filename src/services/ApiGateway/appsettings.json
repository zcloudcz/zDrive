{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        // The MCP tools call FileService/StorageService with the share token IN THE
        // REQUEST PATH (/api/v1/shares/link/{token}/...). HttpClient's default logging
        // (System.Net.Http.HttpClient.*.LogicalHandler/ClientHandler) logs the full
        // request URI at Information, which would put that bearer credential in the
        // console and Seq on every MCP call. Do not lower this below Warning.
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Mcp": {
    "MaxInlineBytes": 26214400
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/auth/{**catch-all}" }
        ]
      },
      "users-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/users/{**catch-all}" }
        ]
      },
      "files-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/files/{**catch-all}" }
        ]
      },
      "sharesLinkRoute": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "publicShare",
        "Match": {
          "Path": "/api/v1/shares/link/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/shares/link/{**catch-all}" }
        ]
      },
      "shares-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/shares/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/shares/{**catch-all}" }
        ]
      },
      "storageSharedRoute": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "publicShare",
        "Match": {
          "Path": "/api/v1/storage/shared/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/storage/shared/{**catch-all}" }
        ]
      },
      "storage-upload-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "chunk",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/storage/upload/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/storage/upload/{**catch-all}" }
        ]
      },
      "storage-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/storage/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/storage/{**catch-all}" }
        ]
      },
      "sync-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/sync/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/sync/{**catch-all}" }
        ]
      },
      "photos-thumbnail-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "thumbnail",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/photos/{id}/thumbnail/{size}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/photos/{id}/thumbnail/{size}" }
        ]
      },
      "photos-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/photos/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/photos/{**catch-all}" }
        ]
      },
      "albums-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/albums/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/albums/{**catch-all}" }
        ]
      },
      "memories-route": {
        "ClusterId": "apiCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/memories/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/memories/{**catch-all}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notificationCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/notifications/{**catch-all}" }
        ]
      },
      "sync-hub-route": {
        "ClusterId": "notificationCluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/hubs/sync/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/sync/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": {
          "apiService": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "notificationCluster": {
        "Destinations": {
          "notificationService": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
