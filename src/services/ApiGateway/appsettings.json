{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "authCluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/auth/{**catch-all}" }
        ]
      },
      "users-route": {
        "ClusterId": "authCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/users/{**catch-all}" }
        ]
      },
      "files-route": {
        "ClusterId": "fileCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/files/{**catch-all}" }
        ]
      },
      "shares-route": {
        "ClusterId": "fileCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/shares/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/shares/{**catch-all}" }
        ]
      },
      "storage-upload-route": {
        "ClusterId": "storageCluster",
        "RateLimiterPolicy": "chunk",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/storage/upload/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/storage/upload/{**catch-all}" }
        ]
      },
      "storage-route": {
        "ClusterId": "storageCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/storage/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/storage/{**catch-all}" }
        ]
      },
      "sync-route": {
        "ClusterId": "syncCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/sync/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/sync/{**catch-all}" }
        ]
      },
      "photos-route": {
        "ClusterId": "photoCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/photos/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/photos/{**catch-all}" }
        ]
      },
      "albums-route": {
        "ClusterId": "photoCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/albums/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/albums/{**catch-all}" }
        ]
      },
      "memories-route": {
        "ClusterId": "photoCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/memories/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/memories/{**catch-all}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notificationCluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/notifications/{**catch-all}" }
        ]
      },
      "sync-hub-route": {
        "ClusterId": "notificationCluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/hubs/sync/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/sync/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "authService": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "fileCluster": {
        "Destinations": {
          "fileService": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "storageCluster": {
        "Destinations": {
          "storageService": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "syncCluster": {
        "Destinations": {
          "syncService": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "photoCluster": {
        "Destinations": {
          "photoService": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "notificationCluster": {
        "Destinations": {
          "notificationService": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
