{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/auth/{**catch-all}" }
        ]
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/users/{**catch-all}" }
        ]
      },
      "files-route": {
        "ClusterId": "file-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/files/{**catch-all}" }
        ]
      },
      "shares-route": {
        "ClusterId": "file-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/shares/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/shares/{**catch-all}" }
        ]
      },
      "storage-route": {
        "ClusterId": "storage-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/storage/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/storage/{**catch-all}" }
        ]
      },
      "sync-route": {
        "ClusterId": "sync-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/sync/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/sync/{**catch-all}" }
        ]
      },
      "photos-route": {
        "ClusterId": "photo-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/photos/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/photos/{**catch-all}" }
        ]
      },
      "albums-route": {
        "ClusterId": "photo-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/albums/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/albums/{**catch-all}" }
        ]
      },
      "memories-route": {
        "ClusterId": "photo-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/memories/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/memories/{**catch-all}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/notifications/{**catch-all}" }
        ]
      },
      "sync-hub-route": {
        "ClusterId": "notification-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-service": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "storage-cluster": {
        "Destinations": {
          "storage-service": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "sync-cluster": {
        "Destinations": {
          "sync-service": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "photo-cluster": {
        "Destinations": {
          "photo-service": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
