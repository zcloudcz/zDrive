root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{dart}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{tf,tfvars}]
indent_style = space
indent_size = 2

[*.{json}]
indent_style = space
indent_size = 2

[*.{xml,csproj,props,targets}]
indent_style = space
indent_size = 2

[*.{md}]
trim_trailing_whitespace = false

[Dockerfile]
indent_style = space
indent_size = 4

[*.{sql}]
indent_style = space
indent_size = 2

[*.{tpl}]
indent_style = space
indent_size = 2
