# zDrive auth-service-only secrets. Copy to .env.auth-secrets and fill in.
# Never commit .env.auth-secrets — kept separate from .env so the JWT
# signing key is only loaded into auth-service's container (docker-compose.prod.yml),
# not into every service via the shared env_file.

# JWT RSA private key (PEM), required outside Development — see CLAUDE.md
# "JWT dev keys". Generate together with the public key in .env.example:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
Jwt__RsaPrivateKeyPem=
